SERVER_PORT=8080
CAMPUSCIRCLE_WEB_PORT=8088
CAMPUSCIRCLE_BIND_ADDRESS=127.0.0.1

CAMPUSCIRCLE_MYSQL_PORT=3307
CAMPUSCIRCLE_DB_URL=jdbc:mysql://localhost:3307/campuscircle?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
CAMPUSCIRCLE_DB_USERNAME=root
CAMPUSCIRCLE_DB_PASSWORD=campuscircle_dev_pwd

CAMPUSCIRCLE_REDIS_HOST=localhost
CAMPUSCIRCLE_REDIS_PORT=6379
CAMPUSCIRCLE_REDIS_PASSWORD=
CAMPUSCIRCLE_REDIS_DATABASE=0
CAMPUSCIRCLE_AUTH_REFRESH_COOKIE_SECURE=false
CAMPUSCIRCLE_AVATAR_STORAGE_DIR=./data/uploads/avatars

CAMPUSCIRCLE_VIEW_COUNT_FLUSH_INTERVAL_SECONDS=10
CAMPUSCIRCLE_HOT_POST_CACHE_TTL_SECONDS=300
CAMPUSCIRCLE_HOT_POST_CACHE_JITTER_SECONDS=60
CAMPUSCIRCLE_HOT_POST_EMPTY_CACHE_TTL_SECONDS=30
CAMPUSCIRCLE_HOT_POST_REBUILD_LOCK_TTL_SECONDS=10
CAMPUSCIRCLE_NEARBY_SCHOOL_CACHE_TTL_SECONDS=300
CAMPUSCIRCLE_NEARBY_SCHOOL_CACHE_JITTER_SECONDS=60

# Keep mock for local development. For a compatible remote provider, set provider to openai-compatible.
CAMPUSCIRCLE_AI_PROVIDER=mock
CAMPUSCIRCLE_AI_BASE_URL=
CAMPUSCIRCLE_AI_API_KEY=
CAMPUSCIRCLE_AI_MODEL=
CAMPUSCIRCLE_AI_TIMEOUT_SECONDS=20
CAMPUSCIRCLE_AI_MAX_RETRIES=1
CAMPUSCIRCLE_AI_MAX_REQUESTS_PER_MINUTE=5
CAMPUSCIRCLE_AI_MAX_OUTPUT_TOKENS=600
CAMPUSCIRCLE_AI_STRUCTURED_OUTPUT=false
# Optional provider-specific setting. For Qwen mixed-thinking models, use false for short RAG answers.
CAMPUSCIRCLE_AI_ENABLE_THINKING=

# Hybrid retrieval is disabled by default. Enable it after Elasticsearch is running and indexed.
CAMPUSCIRCLE_ES_PORT=9200
CAMPUSCIRCLE_SEARCH_ENABLED=false
CAMPUSCIRCLE_SEARCH_BASE_URL=http://localhost:9200
CAMPUSCIRCLE_SEARCH_POST_INDEX=campuscircle-posts
CAMPUSCIRCLE_SEARCH_REQUEST_TIMEOUT_SECONDS=5
CAMPUSCIRCLE_SEARCH_EMBEDDING_DIMENSIONS=1024
CAMPUSCIRCLE_SEARCH_EMBEDDING_PROVIDER=mock
CAMPUSCIRCLE_SEARCH_EMBEDDING_BASE_URL=
CAMPUSCIRCLE_SEARCH_EMBEDDING_API_KEY=
CAMPUSCIRCLE_SEARCH_EMBEDDING_MODEL=
CAMPUSCIRCLE_SEARCH_EMBEDDING_TIMEOUT_SECONDS=20
CAMPUSCIRCLE_SEARCH_CANDIDATE_LIMIT=20
CAMPUSCIRCLE_SEARCH_RRF_RANK_CONSTANT=60

CAMPUSCIRCLE_ROCKETMQ_NAME_SERVER=localhost:9876
CAMPUSCIRCLE_ROCKETMQ_PRODUCER_GROUP=campuscircle-producer-group
CAMPUSCIRCLE_COMMENT_TOPIC=campuscircle-comment-event
CAMPUSCIRCLE_LIKE_TOPIC=campuscircle-like-event
CAMPUSCIRCLE_OUTBOX_DISPATCH_INTERVAL_MILLIS=1000
